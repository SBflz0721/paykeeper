# ===== KeeperHub 执行层（必填）=====
# 组织 API Key，在 app.keeperhub.com -> Settings -> API Keys -> Organisation 创建（kh_ 前缀）
KEEPERHUB_API_KEY=kh_your_key_here

# 可选：组织作用域（API Key 已绑定组织，通常无需单独设置）
KEEPERHUB_ORG=

# MCP 端点与传输方式（一般无需修改）
KEEPERHUB_MCP_URL=https://app.keeperhub.com/mcp
KEEPERHUB_MCP_TRANSPORT=streamable_http

# ===== LLM（Agent 推理用，必填其一）=====
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# DeepSeek 走 OpenAI 兼容 API（见 agent/agent.py build_llm），key 在 platform.deepseek.com 申请
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
MOONSHOT_API_KEY=
ZHIPU_API_KEY=
# Ollama 本地推理无需 key（本机先 ollama pull <模型名>）
OLLAMA_API_KEY=
# 自定义 OpenAI 兼容端点（LLM_PROVIDER=custom 时必填）
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=
# provider: anthropic（默认）| openai | deepseek | openrouter | groq | moonshot | zhipu | ollama | custom
LLM_PROVIDER=anthropic
# 必填：代码不预设默认模型，请到对应 provider 控制台/文档查当前可用模型后填写
LLM_MODEL=

# ===== 目标网络（开发用 Sepolia，提交优选主网 + Gas Sponsorship）=====
# 参考：Sepolia=11155111, Base Sepolia=84532, Ethereum=1, Base=8453
TARGET_CHAIN_ID=11155111

# ===== 演示用付款参数（仅示例，运行前改掉）=====
# 收款地址（演示时换成你控制的地址）
DEMO_RECIPIENT=0x0000000000000000000000000000000000000000
# 付款金额（单位：代币最小精度对应的小数，如 1.0 = 1 USDC）
DEMO_AMOUNT=0.01
# ERC-20 地址；留空表示转原生币（如 Sepolia ETH）
DEMO_TOKEN_ADDRESS=

# ===== Dashboard 安全 =====
# 鉴权 token：所有 /api/*（除 /health）都需要 Authorization: Bearer <token>。
# 不设置会自动生成一个随机 token 并持久化到 data/.dashboard_token（启动日志会打印）。
# 生产/公网部署务必显式设置并只绑 127.0.0.1（见 README）。
DASHBOARD_TOKEN=
# 允许执行的链（逗号分隔；默认仅测试网 Sepolia=11155111, Base Sepolia=84532）。
# 请求方/LLM 传的 chain_id 必须在此名单内，防止把交易指到主网等任意网络。
PAYKEEPER_ALLOWED_CHAIN_IDS=11155111,84532
# 自定义 OpenAI 兼容端点 base_url 域名白名单（逗号分隔）。
# 防止 /api/provider 把 LLM key 转发到攻击者服务器；不配置则禁止 custom provider。
OPENAI_COMPATIBLE_BASE_URL_ALLOWLIST=

# ===== x402 按次付费（可选，主奖能力面）=====
# 签名用 EOA 私钥（仅在跑 x402 按次付费时设置，必须在 Base 充 USDC）
X402_PRIVATE_KEY=
# facilitator 端点白名单（逗号分隔；keeperhub.com 域默认允许，勿改成不可信域名）
X402_FACILITATOR_ALLOWLIST=
X402_FACILITATOR_URL=
# 单笔 x402 支付上限（最小精度单位，默认 100 USDC = 100000000）。
# challenge 金额超过上限直接拒绝，防止被恶意工作流诱导签署大额转账。
X402_MAX_AMOUNT_WEI=100000000
# 允许结算的资产白名单（逗号分隔；默认仅 Base 主网/Sepolia USDC）。
# 防止被诱导签非预期资产。
X402_ASSET_ALLOWLIST=
# KeeperHub 钱包 integrationId（Dashboard 钱包页用；在 KeeperHub 控制台 Wallet 里查，
# 也可在 Dashboard 的 KeeperHub 标签页前端配置）
WALLET_INTEGRATION_ID=
